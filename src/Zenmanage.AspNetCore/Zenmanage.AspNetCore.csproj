<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Zenmanage.AspNetCore</AssemblyName>
    <RootNamespace>Zenmanage.AspNetCore</RootNamespace>
    <Description>ASP.NET Core integration for the Zenmanage feature flag SDK. Provides dependency injection extensions and request-scoped context middleware.</Description>
    <PackageId>Zenmanage.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zenmanage\Zenmanage.csproj" />
  </ItemGroup>
</Project>
